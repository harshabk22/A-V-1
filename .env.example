# MoatAgeex / AGX Configuration
# Copy this file to .env or configure directly in the app Settings modal.

# LLM Provider: "nvidia" (default) or "deepseek"
AGEEX_PROVIDER=nvidia

# NVIDIA NIM API Key
# Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# DeepSeek API Key (Alternative)
# Get your key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# Model Override (Optional)
# NVIDIA default: meta/llama-3.3-70b-instruct
# DeepSeek default: deepseek-chat
AGEEX_MODEL=meta/llama-3.3-70b-instruct

# Local Gateway Port (Optional, default 18443)
# MOAT_GATEWAY_PORT=18443
