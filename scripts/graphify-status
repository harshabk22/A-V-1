#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
graph_json="$repo_root/graphify-out/graph.json"
graph_report="$repo_root/graphify-out/GRAPH_REPORT.md"

source_paths=(
  "$repo_root/moat_core"
  "$repo_root/ageex_ui"
  "$repo_root/moat_watcher"
  "$repo_root/sandbox"
  "$repo_root/references"
)

find_newer_source() {
  local candidates=()
  for path in "${source_paths[@]}"; do
    [[ -d "$path" ]] && candidates+=("$path")
  done

  if [[ ${#candidates[@]} -eq 0 ]]; then
    return 0
  fi

  find "${candidates[@]}" \
    -type f \
    \( \
      -name '*.rs' -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.jsx' -o \
      -name '*.py' -o -name '*.md' -o -name '*.json' -o -name '*.toml' -o -name '*.yaml' -o -name '*.yml' \
    \) \
    ! -path '*/node_modules/*' \
    ! -path '*/dist/*' \
    ! -path '*/target/*' \
    ! -path '*/.venv-graphifyy/*' \
    -newer "$graph_json" \
    -print -quit 2>/dev/null || true
}

hook_output() {
  local message="$1"
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","additionalContext":"%s"}}\n' "$message"
}

if [[ ! -x "$repo_root/.venv-graphifyy/bin/graphify" ]]; then
  message="graphify: local CLI is not installed in .venv-graphifyy; knowledge-graph guidance is unavailable until it is installed."
  if [[ "${1:-}" == "--hook" ]]; then
    hook_output "$message"
  else
    echo "$message"
  fi
  exit 0
fi

if [[ ! -f "$graph_json" ]]; then
  message="graphify: graphify-out/graph.json is missing. Run ./scripts/graphify-refresh before relying on graph-driven codebase answers."
  if [[ "${1:-}" == "--hook" ]]; then
    hook_output "$message"
  else
    echo "$message"
  fi
  exit 0
fi

newer_source="$(find_newer_source)"
if [[ -n "$newer_source" ]]; then
  relative_source="${newer_source#$repo_root/}"
  message="graphify: graph.json is stale compared with ${relative_source}. Read ${graph_report#$repo_root/} carefully and run ./scripts/graphify-refresh after code changes."
else
  message="graphify: knowledge graph is present and appears fresh. Read graphify-out/GRAPH_REPORT.md before digging into raw files."
fi

if [[ "${1:-}" == "--hook" ]]; then
  hook_output "$message"
else
  echo "$message"
fi
